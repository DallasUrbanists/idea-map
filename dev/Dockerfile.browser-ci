# The amd64 browser image pins Chromium and its operating-system libraries
# together.
FROM node:26.13.0-bookworm-slim@sha256:bc0a2afd3b74ce12222fc8bab99271e66257f021078f5f4a5d687a77d280c1d9 AS node
FROM chromedp/headless-shell@sha256:b9f182c7474cc773513e672054bc2d9df90fe479e90a356fddaaef4b9492c230
COPY --from=node /usr/local/ /usr/local/
WORKDIR /workspace
ENV CHROME_PATH=/headless-shell/headless-shell
RUN --mount=type=secret,id=proxy_ca \
    export NODE_USE_ENV_PROXY=1 \
    && if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi \
    && corepack enable pnpm && corepack prepare pnpm@11.25.0 --activate
COPY . .
RUN --mount=type=secret,id=proxy_ca \
    export NODE_USE_ENV_PROXY=1 \
    && if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi \
    && pnpm install --frozen-lockfile
ENTRYPOINT []
CMD ["pnpm", "--filter", "@idea-map/web", "test:dialog"]
