# The amd64 browser image pins Chromium and its operating-system libraries
# together.
FROM node:26.13.0-bookworm-slim@sha256:add5c17c14752c54d2f3d519ec46a3815684d41c33f198bcb09fb998f7dcbf68 AS node
FROM chromedp/headless-shell@sha256:b9f182c7474cc773513e672054bc2d9df90fe479e90a356fddaaef4b9492c230
COPY --from=node /usr/local/ /usr/local/
COPY --from=node /usr/lib/*/libatomic.so.1* /usr/local/lib/
RUN ldconfig && node --version
WORKDIR /workspace
ENV CHROME_PATH=/headless-shell/headless-shell
RUN --mount=type=secret,id=proxy_ca \
    export NODE_USE_ENV_PROXY=1 \
    && if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi \
    && npm install --global pnpm@11.25.0
COPY . .
RUN --mount=type=secret,id=proxy_ca \
    export NODE_USE_ENV_PROXY=1 \
    && if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi \
    && pnpm install --frozen-lockfile
ENTRYPOINT []
CMD ["pnpm", "--filter", "@idea-map/web", "test:dialog"]
