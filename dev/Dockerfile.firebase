FROM node:26.13.0-trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-21-jre-headless ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global firebase-tools@15.34.2
WORKDIR /emulator
COPY dev/firebase.json dev/firestore.rules ./
CMD ["firebase", "emulators:start", "--project", "demo-idea-map", "--only", "auth,firestore"]
