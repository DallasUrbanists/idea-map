{
  "name": "idea-map",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "build": "tsc --build && pnpm --filter @idea-map/web build",
    "typecheck": "tsc --build && pnpm --filter @idea-map/web typecheck",
    "lint": "node scripts/check-boundaries.mjs",
    "test": "tsc --build && pnpm --filter @idea-map/web exec nuxt prepare && node --test scripts/*.test.mjs",
    "test:web": "node --test scripts/nuxt-smoke.mjs",
    "test:webhook": "node --test scripts/resend-webhook.integration.mjs",
    "test:pool": "node --test scripts/runtime-pool.integration.mjs",
    "test:preview": "node --test scripts/media-preview.integration.mjs",
    "test:preview:provider": "node --test scripts/media-preview.provider.integration.mjs",
    "test:web:published": "node --test scripts/nuxt-published-smoke.mjs",
    "test:ownership-claim": "node --test scripts/ownership-claim.integration.mjs",
    "test:moderator-auth": "node --test scripts/moderator-auth.integration.mjs",
    "test:registered-submission-auth": "node --test scripts/registered-submission-emulator.integration.mjs",
    "test:auth": "node --test scripts/session-emulator.integration.mjs scripts/auth-browser.integration.mjs scripts/auth-cleanup-emulator.integration.mjs",
    "dev": "tsc --build && pnpm --filter @idea-map/web dev --dotenv ../../.env --host 127.0.0.1",
    "dev:storybook": "pnpm --filter @idea-map/web storybook --no-open",
    "dev:services": "node scripts/dev-services.mjs start",
    "dev:all": "node scripts/dev-services.mjs all",
    "dev:status": "node scripts/dev-services.mjs status",
    "dev:check": "node scripts/dev-check.mjs",
    "fixture:jobs": "node scripts/local-job-fixture.mjs",
    "test:job-fixture": "node --test scripts/local-job-fixture.integration.mjs",
    "dev:logs": "node scripts/dev-services.mjs logs",
    "dev:db:migrate": "node scripts/dev-migrate.mjs",
    "dev:db:migrate:container": "node scripts/dev-services.mjs migrate",
    "dev:stop": "node scripts/dev-services.mjs stop",
    "changeset": "changeset",
    "release:status": "changeset status",
    "dev:fixtures:seed": "node scripts/local-fixtures.mjs seed",
    "dev:fixtures:clean": "node scripts/local-fixtures.mjs clean",
    "test:fixtures": "node --test scripts/local-fixtures.integration.mjs",
    "test:offline-job-delivery": "node scripts/offline-job-delivery.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@vue/compiler-sfc": "3.5.44",
    "typescript": "5.9.3"
  }
}
